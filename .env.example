# Your Zone username and API key: https://help.zone.eu/en/kb/zone-api-en/
# Keep this file out of version control and chmod 600 it.
ZONE_USERNAME=YOUR_ZONE_USERNAME
ZONE_API_KEY=YOUR_ZONE_API_KEY
# Time to wait (seconds) until next try or network error
NETWORK_RETRY_DELAY=10
# Frequency of checking records and external IP address (minutes)
CHECK_FREQUENCY=5
# How many times a single DNS operation is tried before giving up until the next cycle
MAX_ATTEMPTS=5
# How much to log: debug, info, warn or error (default info).
# info = only things that happened. debug = every poll, including the ones that change
# nothing. Temporarily raise it with:  LOG_LEVEL=debug docker compose up -d
LOG_LEVEL=info
TZ=Europe/Tallinn

# The user id the container runs as. Leave these commented out unless a non-root account
# is the one editing conf/records.conf - they own the files the updater rewrites, and
# those files are mode 0660, so with the default another account could not read them.
# Find your ids with `id -u` and `id -g`; chown conf/ to match.
# PUID=1000
# PGID=1000
